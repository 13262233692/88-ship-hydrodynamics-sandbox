#pragma kernel InitializeWater
#pragma kernel UpdateSWE
#pragma kernel UpdateNormals
#pragma kernel ApplyKelvinWakePressure
#pragma kernel ApplyHullDisplacement
#pragma kernel ApplyBoundaryConditionsRead
#pragma kernel AddWaveSourceRead

#define THREAD_GROUP_SIZE_X 16
#define THREAD_GROUP_SIZE_Y 16
#define PI 3.14159265358979323846f

Texture2D<float> _HeightFieldRead;
RWTexture2D<float> _HeightFieldWrite;
Texture2D<float2> _VelocityFieldRead;
RWTexture2D<float2> _VelocityFieldWrite;
RWTexture2D<float4> _NormalField;
Texture2D<float> _HullHeightMask;

int _GridWidth;
int _GridHeight;
float _CellSize;
float _TimeStep;
float _Gravity;
float _Viscosity;
float _RestDepth;
float _Damping;
float _Time;
float _WaterDensity;
float _WaterSize;

float3 _ShipPosition;
float2 _ShipVelocity;
float _ShipLength;
float _ShipBeam;
float _ShipDraft;
float _BowDraft;
float _SternDraft;
float _ShipHeading;
float _ShipSpeed;
float _FroudeNumber;

struct WaveSource
{
    float2 position;
    float amplitude;
    float frequency;
    float phase;
    float2 direction;
    float decay;
};

StructuredBuffer<WaveSource> _WaveSources;
int _WaveSourceCount;

groupshared float g_sharedHeight[THREAD_GROUP_SIZE_X * THREAD_GROUP_SIZE_Y];
groupshared float2 g_sharedVelocity[THREAD_GROUP_SIZE_X * THREAD_GROUP_SIZE_Y];

bool IsInsideBounds(int2 pos)
{
    return pos.x >= 0 && pos.x < _GridWidth &&
           pos.y >= 0 && pos.y < _GridHeight;
}

float SampleHeightRead(int2 pos)
{
    pos = clamp(pos, int2(0, 0), int2(_GridWidth - 1, _GridHeight - 1));
    return _HeightFieldRead[pos];
}

float2 SampleVelocityRead(int2 pos)
{
    pos = clamp(pos, int2(0, 0), int2(_GridWidth - 1, _GridHeight - 1));
    return _VelocityFieldRead[pos];
}

float2 GridToWorld(int2 pos)
{
    float2 uv = float2(pos) / float2(_GridWidth, _GridHeight);
    return (uv - 0.5f) * _WaterSize;
}

[numthreads(THREAD_GROUP_SIZE_X, THREAD_GROUP_SIZE_Y, 1)]
void InitializeWater(uint3 id : SV_DispatchThreadID)
{
    int2 pos = int2(id.x, id.y);
    if (!IsInsideBounds(pos)) return;

    _HeightFieldWrite[pos] = 0.0f;
    _VelocityFieldWrite[pos] = float2(0.0f, 0.0f);
    _NormalField[pos] = float4(0.0f, 1.0f, 0.0f, 0.0f);
}

[numthreads(THREAD_GROUP_SIZE_X, THREAD_GROUP_SIZE_Y, 1)]
void UpdateSWE(uint3 id : SV_DispatchThreadID, uint groupIndex : SV_GroupIndex)
{
    int2 pos = int2(id.x, id.y);
    if (!IsInsideBounds(pos)) return;

    float h = SampleHeightRead(pos);
    float h_L = SampleHeightRead(pos + int2(-1, 0));
    float h_R = SampleHeightRead(pos + int2(1, 0));
    float h_D = SampleHeightRead(pos + int2(0, -1));
    float h_U = SampleHeightRead(pos + int2(0, 1));

    float h_LL = SampleHeightRead(pos + int2(-2, 0));
    float h_RR = SampleHeightRead(pos + int2(2, 0));
    float h_DD = SampleHeightRead(pos + int2(0, -2));
    float h_UU = SampleHeightRead(pos + int2(0, 2));

    float2 vel = SampleVelocityRead(pos);
    float2 vel_L = SampleVelocityRead(pos + int2(-1, 0));
    float2 vel_R = SampleVelocityRead(pos + int2(1, 0));
    float2 vel_D = SampleVelocityRead(pos + int2(0, -1));
    float2 vel_U = SampleVelocityRead(pos + int2(0, 1));

    g_sharedHeight[groupIndex] = h;
    g_sharedVelocity[groupIndex] = vel;

    GroupMemoryBarrierWithGroupSync();

    float invDx = 1.0f / _CellSize;
    float inv2Dx = 0.5f * invDx;

    float dhdx = (h_R - h_L) * inv2Dx;
    float dhdy = (h_U - h_D) * inv2Dx;

    float d2hdx2 = (h_R - 2.0f * h + h_L) * invDx * invDx;
    float d2hdy2 = (h_U - 2.0f * h + h_D) * invDx * invDx;

    float d4hdx4 = (h_RR - 4.0f * h_R + 6.0f * h - 4.0f * h_L + h_LL) * pow(invDx, 4.0f);
    float d4hdy4 = (h_UU - 4.0f * h_U + 6.0f * h - 4.0f * h_D + h_DD) * pow(invDx, 4.0f);

    float d = _RestDepth + h;
    d = max(d, 0.001f);

    float duvdx = ((vel_R.x * (h_R + _RestDepth)) - (vel_L.x * (h_L + _RestDepth))) * inv2Dx;
    float duvdy = ((vel_U.y * (h_U + _RestDepth)) - (vel_D.y * (h_D + _RestDepth))) * inv2Dx;

    float continuitySource = -(duvdx + duvdy);

    float dudx = (vel_R.x - vel_L.x) * inv2Dx;
    float dudy = (vel_U.x - vel_D.x) * inv2Dx;
    float dvdx = (vel_R.y - vel_L.y) * inv2Dx;
    float dvdy = (vel_U.y - vel_D.y) * inv2Dx;

    float advectionU = vel.x * dudx + vel.y * dudy;
    float advectionV = vel.x * dvdx + vel.y * dvdy;

    float pressureU = -_Gravity * dhdx;
    float pressureV = -_Gravity * dhdy;

    float viscousU = _Viscosity * (d2hdx2 + d2hdy2);
    float viscousV = _Viscosity * (d2hdx2 + d2hdy2);

    float nu = 0.01f;
    float dispersionU = -nu * (d4hdx4 + d4hdy4);
    float dispersionV = -nu * (d4hdx4 + d4hdy4);

    float newU = vel.x + _TimeStep * (pressureU - advectionU + viscousU + dispersionU);
    float newV = vel.y + _TimeStep * (pressureV - advectionV + viscousV + dispersionV);

    float celerity = sqrt(_Gravity * d);
    float maxSpeed = celerity + max(abs(vel.x), abs(vel.y));
    float cfl = maxSpeed * _TimeStep / _CellSize;
    if (cfl > 0.5f)
    {
        float scale = 0.5f / max(cfl, 0.001f);
        newU = vel.x + (newU - vel.x) * scale;
        newV = vel.y + (newV - vel.y) * scale;
    }

    newU *= (1.0f - _Damping * _TimeStep);
    newV *= (1.0f - _Damping * _TimeStep);

    float newH = h + _TimeStep * continuitySource;

    _HeightFieldWrite[pos] = newH;
    _VelocityFieldWrite[pos] = float2(newU, newV);
}

[numthreads(THREAD_GROUP_SIZE_X, THREAD_GROUP_SIZE_Y, 1)]
void UpdateNormals(uint3 id : SV_DispatchThreadID)
{
    int2 pos = int2(id.x, id.y);
    if (!IsInsideBounds(pos)) return;

    float h = SampleHeightRead(pos);
    float h_L = SampleHeightRead(pos + int2(-1, 0));
    float h_R = SampleHeightRead(pos + int2(1, 0));
    float h_D = SampleHeightRead(pos + int2(0, -1));
    float h_U = SampleHeightRead(pos + int2(0, 1));

    float h_UL = SampleHeightRead(pos + int2(-1, 1));
    float h_UR = SampleHeightRead(pos + int2(1, 1));
    float h_DL = SampleHeightRead(pos + int2(-1, -1));
    float h_DR = SampleHeightRead(pos + int2(1, -1));

    float invDx = 1.0f / (8.0f * _CellSize);

    float dhdx = ((h_DR + 2.0f * h_R + h_UR) - (h_DL + 2.0f * h_L + h_UL)) * invDx;
    float dhdy = ((h_UL + 2.0f * h_U + h_UR) - (h_DL + 2.0f * h_D + h_DR)) * invDx;

    float3 normal = normalize(float3(-dhdx, 1.0f, -dhdy));

    float slope = length(float2(dhdx, dhdy));

    _NormalField[pos] = float4(normal, slope);
}

float2x2 RotationMatrix2D(float angle)
{
    float s = sin(angle);
    float c = cos(angle);
    return float2x2(c, -s, s, c);
}

float Gaussian2D(float2 p, float sigma)
{
    return exp(-dot(p, p) / (2.0f * sigma * sigma));
}

[numthreads(THREAD_GROUP_SIZE_X, THREAD_GROUP_SIZE_Y, 1)]
void ApplyKelvinWakePressure(uint3 id : SV_DispatchThreadID)
{
    int2 pos = int2(id.x, id.y);
    if (!IsInsideBounds(pos)) return;

    float2 worldPos = GridToWorld(pos);
    float h = SampleHeightRead(pos);
    float2 vel = SampleVelocityRead(pos);

    float speed = _ShipSpeed;

    if (speed < 0.1f)
    {
        _HeightFieldWrite[pos] = h;
        _VelocityFieldWrite[pos] = vel;
        return;
    }

    float2 shipPos2D = float2(_ShipPosition.x, _ShipPosition.z);
    float2 relPos = worldPos - shipPos2D;

    float cosH = cos(_ShipHeading);
    float sinH = sin(_ShipHeading);
    float2x2 toLocal = float2x2(cosH, sinH, -sinH, cosH);

    float2 localPos = mul(toLocal, relPos);

    float halfL = _ShipLength * 0.5f;
    float halfB = _ShipBeam * 0.5f;

    float bowLocal = halfL;
    float sternLocal = -halfL;

    float q = 0.5f * _WaterDensity * speed * speed;

    float bowSigmaX = _ShipBeam * 0.5f;
    float bowSigmaY = _ShipBeam * 0.8f;
    float sternSigmaX = _ShipBeam * 0.8f;
    float sternSigmaY = _ShipBeam * 1.5f;

    float2 bowCenter = float2(bowLocal * 0.85f, 0.0f);
    float2 bowP = localPos - bowCenter;
    float bowEnvelope = Gaussian2D(bowP, bowSigmaX) * smoothstep(halfB * 2.0f, 0.0f, abs(localPos.y));
    float bowPressure = q * (_BowDraft / max(_ShipDraft, 0.01f)) * bowEnvelope;

    float2 midP = float2(0.0f, 0.0f);
    float2 sideOffset = float2(0.0f, halfB * 0.8f);
    float sideSigmaX = halfL * 0.6f;
    float sideSigmaY = _ShipBeam * 0.5f;

    float2 sideP_L = localPos + sideOffset;
    float2 sideP_R = localPos - sideOffset;

    float sideEnv_L = Gaussian2D(sideP_L / float2(sideSigmaX, sideSigmaY), 1.0f);
    float sideEnv_R = Gaussian2D(sideP_R / float2(sideSigmaX, sideSigmaY), 1.0f);

    float draftRatio = _ShipDraft / max(_RestDepth, 0.01f);
    float blockageCoeff = draftRatio * (1.0f + draftRatio);

    float sidePressure = -q * 0.35f * blockageCoeff * (sideEnv_L + sideEnv_R);

    float2 sternCenter = float2(sternLocal * 0.8f, 0.0f);
    float2 sternP = localPos - sternCenter;
    float sternEnvelope = Gaussian2D(sternP, sternSigmaX) * smoothstep(halfB * 3.0f, 0.0f, abs(localPos.y));
    float sternPressure = -q * 0.5f * (_SternDraft / max(_ShipDraft, 0.01f)) * sternEnvelope;

    float P_total = bowPressure + sidePressure + sternPressure;

    float epsilon = _CellSize * 1.5f;
    float2 localPos_dX = localPos + float2(epsilon, 0.0f);
    float2 localPos_dY = localPos + float2(0.0f, epsilon);

    float2 bowP_dX = localPos_dX - bowCenter;
    float bowEnv_dX = Gaussian2D(bowP_dX, bowSigmaX) * smoothstep(halfB * 2.0f, 0.0f, abs(localPos_dX.y));
    float bowP_dY = localPos_dY - bowCenter;
    float bowEnv_dY = Gaussian2D(bowP_dY, bowSigmaX) * smoothstep(halfB * 2.0f, 0.0f, abs(localPos_dY.y));

    float2 sideP_L_dX = localPos_dX + sideOffset;
    float2 sideP_R_dX = localPos_dX - sideOffset;
    float sideEnv_dX = Gaussian2D(sideP_L_dX / float2(sideSigmaX, sideSigmaY), 1.0f) +
                       Gaussian2D(sideP_R_dX / float2(sideSigmaX, sideSigmaY), 1.0f);

    float2 sideP_L_dY = localPos_dY + sideOffset;
    float2 sideP_R_dY = localPos_dY - sideOffset;
    float sideEnv_dY = Gaussian2D(sideP_L_dY / float2(sideSigmaX, sideSigmaY), 1.0f) +
                       Gaussian2D(sideP_R_dY / float2(sideSigmaX, sideSigmaY), 1.0f);

    float2 sternP_dX = localPos_dX - sternCenter;
    float sternEnv_dX = Gaussian2D(sternP_dX, sternSigmaX) * smoothstep(halfB * 3.0f, 0.0f, abs(localPos_dX.y));
    float2 sternP_dY = localPos_dY - sternCenter;
    float sternEnv_dY = Gaussian2D(sternP_dY, sternSigmaX) * smoothstep(halfB * 3.0f, 0.0f, abs(localPos_dY.y));

    float P_dX = q * (_BowDraft / max(_ShipDraft, 0.01f)) * bowEnv_dX
               - q * 0.35f * blockageCoeff * sideEnv_dX
               - q * 0.5f * (_SternDraft / max(_ShipDraft, 0.01f)) * sternEnv_dX;

    float P_dY = q * (_BowDraft / max(_ShipDraft, 0.01f)) * bowEnv_dY
               - q * 0.35f * blockageCoeff * sideEnv_dY
               - q * 0.5f * (_SternDraft / max(_ShipDraft, 0.01f)) * sternEnv_dY;

    float2 dPdLocal = float2(P_dX - P_total, P_dY - P_total) / epsilon;

    float2x2 toWorld = float2x2(cosH, -sinH, sinH, cosH);
    float2 dPdWorld = mul(toWorld, dPdLocal);

    float invRho = 1.0f / _WaterDensity;
    float2 pressureForceVelocity = -invRho * dPdWorld;

    float depthAtPoint = max(_RestDepth + h, 0.001f);
    float pressureForceHeight = -depthAtPoint * invRho * dPdWorld.x;
    float pressureForceHeightY = -depthAtPoint * invRho * dPdWorld.y;

    float hullMask = 0.0f;
    float2 localAbs = float2(abs(localPos.x), abs(localPos.y));
    if (localAbs.x < halfL * 1.1f && localAbs.y < halfB * 1.5f)
    {
        float nx = localAbs.x / (halfL * 1.1f);
        float ny = localAbs.y / (halfB * 1.5f);
        hullMask = 1.0f - smoothstep(0.85f, 1.0f, max(nx, ny));

        if (localAbs.x < halfL * 0.9f && localAbs.y < halfB * 0.9f)
        {
            hullMask = 1.0f;
        }
    }

    float Fr = speed / sqrt(_Gravity * _ShipLength);
    float kelvinStrength = smoothstep(0.05f, 0.2f, Fr);

    float2 newVel = vel;
    newVel += _TimeStep * pressureForceVelocity * kelvinStrength;

    if (hullMask > 0.5f)
    {
        float2 shipVel2D = _ShipVelocity;
        newVel = lerp(newVel, shipVel2D * 0.3f, hullMask * 0.4f);
    }

    float newH = h;
    newH -= _TimeStep * (pressureForceHeight + pressureForceHeightY) * kelvinStrength * 0.5f;

    if (hullMask > 0.8f)
    {
        float draftContribution = _ShipDraft * hullMask * 0.3f;
        newH = max(newH, draftContribution);
    }

    _HeightFieldWrite[pos] = newH;
    _VelocityFieldWrite[pos] = newVel;
}

[numthreads(THREAD_GROUP_SIZE_X, THREAD_GROUP_SIZE_Y, 1)]
void ApplyHullDisplacement(uint3 id : SV_DispatchThreadID)
{
    int2 pos = int2(id.x, id.y);
    if (!IsInsideBounds(pos)) return;

    float h = SampleHeightRead(pos);
    float2 vel = SampleVelocityRead(pos);
    float hullMaskTex = _HullHeightMask[pos];

    if (hullMaskTex > 0.1f)
    {
        h = max(h, _ShipDraft * hullMaskTex * 0.5f);
    }

    _HeightFieldWrite[pos] = h;
    _VelocityFieldWrite[pos] = vel;
}

[numthreads(THREAD_GROUP_SIZE_X, THREAD_GROUP_SIZE_Y, 1)]
void ApplyBoundaryConditionsRead(uint3 id : SV_DispatchThreadID)
{
    int2 pos = int2(id.x, id.y);
    if (!IsInsideBounds(pos)) return;

    bool isBoundary = pos.x == 0 || pos.x == _GridWidth - 1 ||
                      pos.y == 0 || pos.y == _GridHeight - 1;

    if (isBoundary)
    {
        _HeightFieldWrite[pos] = 0.0f;
        _VelocityFieldWrite[pos] = float2(0.0f, 0.0f);
        return;
    }

    float h = SampleHeightRead(pos);
    float2 vel = SampleVelocityRead(pos);

    int boundaryZone = 5;
    bool nearBoundary = pos.x < boundaryZone || pos.x > _GridWidth - 1 - boundaryZone ||
                        pos.y < boundaryZone || pos.y > _GridHeight - 1 - boundaryZone;

    if (nearBoundary)
    {
        int distToEdge = min(min(pos.x, _GridWidth - 1 - pos.x), min(pos.y, _GridHeight - 1 - pos.y));
        float dampingFactor = 1.0f - smoothstep(0.0f, float(boundaryZone), float(boundaryZone - distToEdge));
        dampingFactor = pow(dampingFactor, 2.0f);

        h *= dampingFactor;
        vel *= dampingFactor;
    }

    _HeightFieldWrite[pos] = h;
    _VelocityFieldWrite[pos] = vel;
}

[numthreads(THREAD_GROUP_SIZE_X, THREAD_GROUP_SIZE_Y, 1)]
void AddWaveSourceRead(uint3 id : SV_DispatchThreadID)
{
    int2 pos = int2(id.x, id.y);
    if (!IsInsideBounds(pos)) return;

    float h = SampleHeightRead(pos);

    float2 worldPos = float2(
        (float(pos.x) / _GridWidth - 0.5f) * 200.0f,
        (float(pos.y) / _GridHeight - 0.5f) * 200.0f
    );

    float totalWave = 0.0f;

    for (int i = 0; i < _WaveSourceCount; i++)
    {
        WaveSource src = _WaveSources[i];

        float2 toPoint = worldPos - src.position;
        float dist = length(toPoint);

        if (dist < 100.0f)
        {
            float alongDir = dot(normalize(toPoint), src.direction);
            float amplitude = src.amplitude * exp(-dist * src.decay) * max(alongDir, 0.0f);

            float phase = src.frequency * dist + src.phase + _Time * src.frequency * 2.0f;
            totalWave += amplitude * sin(phase);
        }
    }

    _HeightFieldWrite[pos] = h + totalWave * _TimeStep;
}
